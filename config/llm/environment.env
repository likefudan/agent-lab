# Agent Lab's LLM CLI seed defaults to the Ollama-native plugin when the active
# backend is ollama. Non-Ollama backends are wired by `agent-lab apply-inference`
# / `backend use` into .agent-lab/llm/ (OpenAI /v1, llm-ollama excluded).
# Do not add remote model credentials to this file.
OLLAMA_HOST=http://127.0.0.1:11434
LLM_LOAD_PLUGINS=llm-ollama
AGENT_LAB_INFERENCE_BACKEND=ollama
AGENT_LAB_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
