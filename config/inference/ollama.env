# Reference defaults for the ollama active backend (P10-T05).
# Runtime file is generated at ~/.agent-lab/state/inference.env by
# `agent-lab apply-inference` / `agent-lab backend use`.
AGENT_LAB_INFERENCE_BACKEND=ollama
AGENT_LAB_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
AGENT_LAB_OPENAI_API_KEY=agent-lab
ENABLE_OLLAMA_API=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_CONFIGS={"0":{"enable":true,"connection_type":"local","model_ids":["qwen3.5:4b","qwen3.5:9b","gemma4:12b"]}}
ENABLE_OPENAI_API=false
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=
OPENAI_API_CONFIGS={}
