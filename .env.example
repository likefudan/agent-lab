# Nonsecret local defaults. Generate the ignored .env used at runtime with:
#   config/open-webui/generate-env.sh
OPEN_WEBUI_PORT=3000

# This documentation-only value lets Compose validate the template. The
# generator replaces it with a stable, random secret and never prints it.
WEBUI_SECRET_KEY=replace-with-generated-64-character-hex-secret

# First-run local administrator. The generator replaces the password placeholder.
WEBUI_ADMIN_EMAIL=admin@localhost
WEBUI_ADMIN_NAME=Agent Lab Admin
WEBUI_ADMIN_PASSWORD=replace-with-generated-32-character-hex-password
